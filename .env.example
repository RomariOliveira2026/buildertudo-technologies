# Site
VITE_SITE_URL=https://buildertudo.com

# Analytics (optional — events fire only when an ID is present)
# Conceptual events: click_whatsapp, click_quote, select_plan, submit_lead, view_portfolio
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# Business OS API (optional — live metrics on /live)
VITE_BUSINESS_OS_API=

# Lead form (optional). If empty, the contact form still validates and opens WhatsApp.
# Do not set this unless a real endpoint is ready — the UI will not fake a backend success.
VITE_FORM_ENDPOINT=

# Reserved / not wired on the commercial site yet
VITE_RESEND_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
